# ==========================================
# TH_ExamGen - Environment Variables Template
# SAO CHÉP TỆP NÀY THÀNH .env ĐỂ CẤU HÌNH CỤC BỘ
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env CHỨA THÔNG TIN THẬT
# ==========================================

# 1. Cấu hình AI Provider (Gemini hoặc DeepSeek)
AI_PROVIDER=Gemini
GEMINI_MODEL=gemini-2.5-flash

# Khóa Gemini API Key của máy chủ (để trống để người dùng tự nhập khóa cá nhân)
# GEMINI_API_KEY=your_gemini_api_key_here

# 2. CSDL PostgreSQL (Supabase Connection Pooler)
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your_project_ref;Password=your_db_password;SSL Mode=Require;

# 3. Mã PIN bảo mật cho trang Quản trị (Admin Panel /admin.html)
ADMIN_PIN=your_secret_admin_pin_here
