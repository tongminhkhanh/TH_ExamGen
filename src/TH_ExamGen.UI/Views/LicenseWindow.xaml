<Window x:Class="TH_ExamGen.UI.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Bản Quyền — TH-Exam Studio" 
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Height="520" Width="600" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13" Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER BRAND -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="#1E293B" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoShieldCheck}" Stroke="#38BDF8" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="BẢN QUYỀN PHẦN MỀM TH-EXAM STUDIO" 
                               FontWeight="Bold" FontSize="15" Foreground="White"/>
                    <TextBlock Text="Hệ thống tạo đề kiểm tra chuẩn GDPT 2018 &amp; Thông tư 27 — Trường Tiểu học Ít Ong" 
                               FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MACHINE ID -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1. MÃ MÁY CỦA BẠN (Gửi mã này qua Zalo để nhận mã kích hoạt):" 
                           FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtMachineId" Grid.Column="0" IsReadOnly="True" 
                             FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                             Foreground="#0F172A" Background="#F1F5F9" Padding="10,6"
                             BorderBrush="#CBD5E1" VerticalAlignment="Center"/>
                    <Button x:Name="btnCopyMachineId" Grid.Column="2" 
                            Style="{StaticResource StitchSecondaryButton}" Height="36" Click="BtnCopyMachineId_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoCopy}" Stroke="#4F46E5" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Sao chép" FontWeight="Bold" Foreground="#4F46E5"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. LICENSE KEY INPUT -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="2. NHẬP MÃ KÍCH HOẠT (LICENSE KEY ĐƯỢC CẤP):" 
                           FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtLicenseKey" Grid.Column="0" 
                             FontFamily="Consolas" FontSize="13.5" FontWeight="Bold"
                             Foreground="#166534" Background="#FEFCE8" Padding="10,6"
                             BorderBrush="#CBD5E1" VerticalAlignment="Center"/>
                    <Button x:Name="btnActivate" Grid.Column="2" 
                            Style="{StaticResource StitchPrimaryButton}" Height="36" Click="BtnActivate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoCheckCircle}" Stroke="White" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Kích hoạt" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. STATUS BADGE -->
        <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Trạng thái bản quyền: " FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblLicenseStatus" Grid.Column="1" Text="Đang kiểm tra..." 
                           FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- 5. CONTACT / HOTLINE -->
        <Border Grid.Row="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LIÊN HỆ ĐĂNG KÝ BẢN QUYỀN TRỌN GÓI NĂM HỌC" FontWeight="Bold" Foreground="#1E40AF" FontSize="12.5"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Hotline / Zalo hỗ trợ kỹ thuật: " Foreground="#334155" FontSize="12.5"/>
                    <TextBlock Text="0326.439.774" FontWeight="Bold" FontSize="14" Foreground="#DC2626"/>
                </StackPanel>
                <TextBlock Text="* Bản quyền cấp theo từng máy tính cá nhân. Hỗ trợ kích hoạt, bảo hành và cập nhật ngân hàng đề thi suốt năm học." 
                           FontSize="11.5" Foreground="#64748B" Margin="0,5,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
