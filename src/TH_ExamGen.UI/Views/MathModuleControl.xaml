<UserControl x:Class="TH_ExamGen.UI.Views.MathModuleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1020">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. MODERN 3-STEP WORKFLOW STEPPER                         -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STEP 1 -->
                <Border x:Name="Step1Border" Grid.Column="0" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="Step1_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step1Badge" Width="30" Height="30" CornerRadius="15" Background="#4F46E5" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Step1Sub" Text="BƯỚC 1" FontSize="11" FontWeight="Bold" Foreground="#4F46E5"/>
                            <TextBlock x:Name="Step1Title" Text="Ma trận &amp; Đặc tả" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONNECTOR 1 -->
                <Path Grid.Column="1" Data="{StaticResource GeoChevronRight}" Stroke="#94A3B8" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0"/>

                <!-- STEP 2 -->
                <Border x:Name="Step2Border" Grid.Column="2" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="Step2_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step2Badge" Width="30" Height="30" CornerRadius="15" Background="#F1F5F9" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="2" Foreground="#64748B" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Step2Sub" Text="BƯỚC 2" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="Step2Title" Text="Sinh đề AI &amp; Xem trước" FontSize="14" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONNECTOR 2 -->
                <Path Grid.Column="3" Data="{StaticResource GeoChevronRight}" Stroke="#94A3B8" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0"/>

                <!-- STEP 3 -->
                <Border x:Name="Step3Border" Grid.Column="4" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="Step3_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step3Badge" Width="30" Height="30" CornerRadius="15" Background="#F1F5F9" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="3" Foreground="#64748B" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Step3Sub" Text="BƯỚC 3" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="Step3Title" Text="Xuất hồ sơ Word (.docx)" FontSize="14" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. MAIN WORKFLOW CONTAINER (CONTROLLED VIA STEPPER)       -->
        <!-- ========================================================= -->
        <TabControl x:Name="TabMath" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="TabMath_SelectionChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- TAB 1: MA TRẬN & ĐẶC TẢ -->
            <TabItem Header="Step1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar (2 Hàng thông thoáng, không bị che nút) -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hàng 1: Bộ lọc Chuẩn & Thao tác bảng -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Khối lớp & Đợt thi & Nạp chuẩn -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Khối:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboGrade" Width="90" Padding="6,5" VerticalContentAlignment="Center" Margin="0,0,12,0" SelectionChanged="CboGradeOrPeriod_SelectionChanged">
                                        <ComboBoxItem Content="Khối 4" IsSelected="True"/>
                                        <ComboBoxItem Content="Khối 5"/>
                                    </ComboBox>

                                    <TextBlock Text="Đợt thi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboPeriod" Width="145" Padding="6,5" VerticalContentAlignment="Center" Margin="0,0,12,0" SelectionChanged="CboGradeOrPeriod_SelectionChanged">
                                        <ComboBoxItem Content="Giữa Học kỳ I"/>
                                        <ComboBoxItem Content="Cuối Học kỳ I"/>
                                        <ComboBoxItem Content="Giữa Học kỳ II"/>
                                        <ComboBoxItem Content="Cuối Học kỳ II" IsSelected="True"/>
                                    </ComboBox>

                                    <Button x:Name="BtnLoadDefaultMatrix" Style="{StaticResource StitchSecondaryButton}" Click="BtnLoadDefaultMatrix_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoRefresh}" Stroke="#475569" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Nạp chuẩn BGD" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Thêm câu & Xóa câu -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnAddRow" Style="{StaticResource StitchSecondaryButton}" Click="BtnAddRow_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoPlus}" Stroke="#475569" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Thêm câu" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnDeleteRow" Style="{StaticResource StitchDangerButton}" Click="BtnDeleteRow_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoTrash}" Stroke="#E11D48" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Xóa câu" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Hàng 2: Trợ lý AI & Thẩm định chuyên môn Thông tư 27 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                <Button x:Name="BtnAiSuggestMatrix" Style="{StaticResource StitchSuccessButton}" Click="BtnAiSuggestMatrix_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoSparkles}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="AI Gợi ý ma trận" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAuditMatrix" Style="{StaticResource StitchWarningButton}" Click="BtnAuditMatrix_Click" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoAudit}" Stroke="#B45309" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Thẩm định TT27" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRestorePreAiMatrix" Style="{StaticResource StitchSecondaryButton}" Click="BtnRestorePreAiMatrix_Click" Margin="0,0,12,0" IsEnabled="False"
                                        ToolTip="Quay lại ma trận ngay trước lần AI gợi ý gần nhất (chỉ dùng được trong phiên làm việc hiện tại)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRefresh}" Stroke="#475569" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Khôi phục bản trước AI" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <ProgressBar x:Name="PbMatrixLoading" IsIndeterminate="True" Width="110" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock Text="Trợ lý AI tự động rà soát ma trận đặc tả theo chuẩn Chương trình GDPT 2018 &amp; Thông tư 27" 
                                           VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Ma Trận -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DataGrid x:Name="DgMatrix" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  HeadersVisibility="Column" GridLinesVisibility="All" AlternationCount="2"
                                  BorderThickness="0" SelectionMode="Single" FontSize="13" RowHeight="34"
                                  CellEditEnding="DgMatrix_CellEditEnding">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                        <!-- Dòng do AI vừa tạo, chưa rà soát: tô vàng; khi thầy/cô sửa dòng, màu tự bỏ -->
                                        <DataTrigger Binding="{Binding IsAiNew}" Value="True">
                                            <Setter Property="Background" Value="#FFF9C4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding SoThuTu}" Width="50" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Chủ đề" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding ChuDe, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Content"
                                                      BorderThickness="0" Background="Transparent"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="DataGridCombo_SelectionChanged">
                                                <ComboBoxItem Content="Số và phép tính"/>
                                                <ComboBoxItem Content="Hình học và đo lường"/>
                                                <ComboBoxItem Content="Thống kê và xác suất"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nội dung kiến thức" Binding="{Binding NoiDungKienThuc, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                                <DataGridTextColumn Header="Yêu cầu cần đạt" Binding="{Binding YeuCauCanDat, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn Header="Mức" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding MucDo, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Content"
                                                      BorderThickness="0" Background="Transparent"
                                                      HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                      SelectionChanged="DataGridCombo_SelectionChanged">
                                                <ComboBoxItem Content="M1"/>
                                                <ComboBoxItem Content="M2"/>
                                                <ComboBoxItem Content="M3"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dạng" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding HinhThuc, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Content"
                                                      BorderThickness="0" Background="Transparent"
                                                      HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                      SelectionChanged="DataGridCombo_SelectionChanged">
                                                <ComboBoxItem Content="TN"/>
                                                <ComboBoxItem Content="TL"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Điểm" Binding="{Binding Diem, StringFormat={}{0:0.#}đ, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridCheckBoxColumn Header="TikZ" Binding="{Binding CoHinhTikz, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Bottom Bar: Live TT27 Compliance Distribution & Action Buttons -->
                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18,14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- TT27 Live Distribution Gauge -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                                <!-- Dòng 1: Tổng hợp phân phối + Huy hiệu trạng thái Thông tư 27 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng hợp phân phối:" Foreground="#64748B" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtSummary" Text="10 câu | 10,0 điểm (7 câu TN - 7,0đ | 3 câu TL - 3,0đ)" 
                                               FontWeight="Bold" Foreground="#0F172A" FontSize="13" VerticalAlignment="Center"/>
                                    
                                    <!-- Huy hiệu trạng thái đạt chuẩn TT27 -->
                                    <Border x:Name="BadgeAccreditation" Background="{StaticResource BrushM1Bg}" BorderBrush="{StaticResource BrushM1Border}" 
                                            BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="IcoAccreditation" Data="{StaticResource GeoCheckCircle}" Stroke="#16A34A" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtAccreditation" Text="Đạt chuẩn TT 27" FontSize="11.5" Foreground="#16A34A" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Dòng 2: 3 Huy hiệu Mức độ nhận thức TT27 -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- M1 Pill -->
                                    <Border Background="{StaticResource BrushM1Bg}" BorderBrush="{StaticResource BrushM1Border}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="M1 (Nhận biết): " FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushM1Text}"/>
                                            <TextBlock x:Name="BadgeM1Text" Text="4.0đ (40%)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushM1Text}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- M2 Pill -->
                                    <Border Background="{StaticResource BrushM2Bg}" BorderBrush="{StaticResource BrushM2Border}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="M2 (Kết nối): " FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushM2Text}"/>
                                            <TextBlock x:Name="BadgeM2Text" Text="3.0đ (30%)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushM2Text}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- M3 Pill -->
                                    <Border Background="{StaticResource BrushM3Bg}" BorderBrush="{StaticResource BrushM3Border}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="M3 (Vận dụng): " FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushM3Text}"/>
                                            <TextBlock x:Name="BadgeM3Text" Text="3.0đ (30%)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushM3Text}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right CTAs -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnExportMatrixOnly" Style="{StaticResource StitchSecondaryButton}" Click="BtnExportMatrixOnly_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoWord}" Stroke="#4F46E5" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Xuất Ma Trận (.docx)" FontWeight="Bold" Foreground="#4F46E5"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnGoToStep2" Style="{StaticResource StitchPrimaryButton}" Click="BtnGoToStep2_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tiếp tục sang Bước 2" FontWeight="Bold"/>
                                        <Path Data="{StaticResource GeoChevronRight}" Stroke="White" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SINH ĐỀ AI & XEM TRƯỚC -->
            <TabItem Header="Step2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnGenerateExam" Style="{StaticResource StitchSuccessButton}" Click="BtnGenerateExam_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoSparkles}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Bắt đầu Sinh Đề bằng Gemini AI" FontWeight="Bold" FontSize="13.5"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnLoadSamplePaper" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Click="BtnLoadSamplePaper_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoFile}" Stroke="#4F46E5" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nạp Đề Mẫu Chuẩn Khối 4" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                    </StackPanel>
                                </Button>
                                <ProgressBar x:Name="PbLoading" IsIndeterminate="True" Width="120" Height="8" Margin="16,0,0,0" Visibility="Collapsed"/>
                                <Button x:Name="BtnCancelGenerate" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnCancelGenerate_Click"
                                        ToolTip="Dừng quá trình sinh đề đang chạy">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✖" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#DC2626"/>
                                        <TextBlock Text="Hủy" FontWeight="SemiBold" Foreground="#DC2626"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="TxtAiStatus" Text="Sẵn sàng gửi Ma trận đặc tả lên Gemini AI..." 
                                           VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#475569" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Questions List Viewer -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PnlQuestionsList">
                                <TextBlock x:Name="TxtEmptyNotice" Text="Chưa có câu hỏi nào. Hãy bấm nút 'Bắt đầu Sinh Đề bằng Gemini AI' hoặc 'Nạp Đề Mẫu Chuẩn' ở trên." 
                                           FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,60,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Bottom Bar -->
                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Button x:Name="BtnSaveDraft" Style="{StaticResource StitchSecondaryButton}" Click="BtnSaveDraft_Click" Margin="0,0,8,0"
                                        ToolTip="Lưu toàn bộ ma trận và đề hiện tại ra một tệp để mở lại sau">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoSave}" Stroke="#4F46E5" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Lưu đề" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenDraft" Style="{StaticResource StitchSecondaryButton}" Click="BtnOpenDraft_Click" Margin="0,0,8,0"
                                        ToolTip="Mở lại một đề đã lưu trước đó">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoFolder}" Stroke="#4F46E5" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Mở đề" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnNewExam" Style="{StaticResource StitchSecondaryButton}" Click="BtnNewExam_Click"
                                        ToolTip="Bỏ đề hiện tại và quay về ma trận mặc định">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoPlus}" Stroke="#4F46E5" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Đề mới" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRerenderTikz" Style="{StaticResource StitchSecondaryButton}" Click="BtnRerenderTikz_Click" Margin="8,0,0,0"
                                        ToolTip="Vẽ lại toàn bộ hình vẽ (TikZ) của đề hiện tại. Dùng khi có hình bị thiếu hoặc vẽ lỗi trước đó.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoSparkles}" Fill="#4F46E5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Vẽ lại hình" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Bạn có thể trực tiếp sửa đề bài, công thức LaTeX và mã TikZ của từng câu trước khi xuất Word. Mọi công thức đều được chuyển thành Word Equation (OMML) chuẩn." 
                                       VerticalAlignment="Center" Foreground="#64748B" FontSize="12.5" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,0,16,0"/>
                            <Button x:Name="BtnGoToStep3" Grid.Column="2" Style="{StaticResource StitchPrimaryButton}" Click="BtnGoToStep3_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tiếp tục sang Bước 3 (Xuất Word)" FontWeight="Bold"/>
                                    <Path Data="{StaticResource GeoChevronRight}" Stroke="White" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: XUẤT FILE WORD -->
            <TabItem Header="Step3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,0,20">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                            <!-- Hero Title -->
                            <TextBlock Text="XUẤT HỒ SƠ ĐỀ KIỂM TRA MÔN TOÁN" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Đề thi chính thức kèm khung điểm chuẩn Bộ GD&amp;ĐT, công thức Word Equation (OMML) sửa trực tiếp, hình vẽ TikZ 300 DPI và lưới bài giải ô ly." 
                                       FontSize="13" Foreground="#64748B" Margin="0,0,0,16"/>

                            <!-- Tùy chọn kiểu xuất -->
                            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CHỌN KIỂU XUẤT FILE" FontWeight="Bold" FontSize="13" Foreground="#4F46E5" Margin="0,0,0,10"/>
                                    <RadioButton x:Name="RbExportExamOnly" Content="Chỉ xuất Đề thi chính thức &amp; Hướng dẫn chấm (Chuẩn in phát học sinh)" 
                                                 IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="RbExportFullPackage" Content="Xuất trọn bộ Hồ sơ (Gồm Ma trận 2 tầng + Bản đặc tả + Đề thi + Hướng dẫn chấm)" 
                                                 FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Border>

                            <!-- Tùy chọn lưới ô ly bài giải -->
                            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOlySectionTitle" Text="TÙY CHỌN LƯỚI Ô LY BÀI GIẢI CÁC CÂU TỰ LUẬN" FontWeight="Bold" FontSize="13" Foreground="#4F46E5" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Số dòng ô ly cho bài tự luận:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CboDefaultOlyLines" Width="320" Padding="8,5">
                                            <ComboBoxItem Content="Giữ theo cấu hình từng câu ở Bước 2" Tag="-1" IsSelected="True"/>
                                            <ComboBoxItem Content="0 dòng lớn (Không kẻ ô ly - Tiết kiệm trang)" Tag="0"/>
                                            <ComboBoxItem Content="4 dòng lớn (16 hàng con - Đặt tính/ngắn)" Tag="4"/>
                                            <ComboBoxItem Content="6 dòng lớn (24 hàng con)" Tag="6"/>
                                            <ComboBoxItem Content="8 dòng lớn (32 hàng con - Chuẩn)" Tag="8"/>
                                            <ComboBoxItem Content="10 dòng lớn (40 hàng con)" Tag="10"/>
                                            <ComboBoxItem Content="12 dòng lớn (48 hàng con)" Tag="12"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="Mỗi dòng viết lớn gồm 4 hàng con (4 ly) với các đường chấm kim chuẩn như trang vở ô ly học sinh tiểu học." 
                                               FontSize="12" FontStyle="Italic" Foreground="#64748B" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Tiêu chuẩn kỹ thuật -->
                            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CÁC ĐỊNH DẠNG TỰ ĐỘNG ĐẠT CHUẨN ĐỀ MẪU 100%" FontSize="13" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Khung điểm 2 ô chuẩn: Ô Điểm &amp; Ô Nhận xét giáo viên (có 3 dòng chấm)." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• Công thức toán LaTeX tự động chuyển thành Word Equation (OMML) chuẩn — click sửa trực tiếp trong Word." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• Vẽ hình, biểu đồ và sơ đồ đoạn thẳng chuẩn TikZ chuyên sâu (300 DPI)." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• Câu hỏi Đúng/Sai trên Bảng No Border cân đối, gắn ô vuông 1.0 cm x 1.0 cm sau phát biểu để học sinh điền Đ/S." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• Trắc nghiệm 4 đáp án (A, B, C, D) dàn đều trên 1 dòng bằng Bảng No Border (công thức OMML)." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• Bảng số liệu thống kê chuẩn Word Table viền đen kẻ ô sắc nét." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• 4 phép tính phân số kèm dòng chấm ngang chuẩn mẫu gốc (không dùng bảng lưới ô ly to)." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• Tiêu đề Bài giải in đậm gạch chân căn giữa, kẻ lưới ô ly 4 ly chuẩn với các đường chấm kim." Margin="0,2" Foreground="#334155"/>
                                    <TextBlock Text="• Hướng dẫn chấm: Bảng trắc nghiệm 3 dòng và Bảng tự luận 2 cột biểu điểm chuẩn OMML." Margin="0,2" Foreground="#334155"/>
                                </StackPanel>
                            </Border>

                            <!-- Export Studio Box -->
                            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Tên tệp xuất (.docx):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtExportFileName" FontSize="14" Padding="10,8" Margin="0,0,0,10"
                                             Text="De_Kiem_Tra_Toan_Lop_4.docx" BorderBrush="#CBD5E1" Background="#F8FAFC"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtExportFolderHint" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnChangeExportFolder" Grid.Column="1" Style="{StaticResource StitchSecondaryButton}" Click="BtnChangeExportFolder_Click"
                                                ToolTip="Đổi nơi lưu file Word (áp dụng cho các lần xuất tiếp theo)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoFolder}" Stroke="#475569" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Đổi thư mục..." FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock x:Name="TxtPaperPoints" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnExportWord" Style="{StaticResource StitchPrimaryButton}" Click="BtnExportWord_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoWord}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Xuất File Word (.docx) Ngay" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnOpenFolder" Style="{StaticResource StitchSecondaryButton}" Margin="12,0,0,0" Visibility="Collapsed" Click="BtnOpenFolder_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoFolder}" Stroke="#475569" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Mở thư mục chứa file" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnOpenFile" Style="{StaticResource StitchSuccessButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnOpenFile_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoFile}" Stroke="White" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Mở file Word" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtExportStatus" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="#16A34A"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
