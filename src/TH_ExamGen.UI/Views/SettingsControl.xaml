<UserControl x:Class="TH_ExamGen.UI.Views.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="880" d:DesignWidth="920">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24,30,40" MaxWidth="860" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="CÀI ĐẶT HỆ THỐNG" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock Text="Thiết lập các mô hình trí tuệ nhân tạo (Google Gemini, DeepSeek) và thông tin hồ sơ trường học" FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

            <!-- Card 0: Choose Active AI Provider -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="NHÀ CUNG CẤP AI MẶC ĐỊNH CHO TẠO ĐỀ" FontSize="13" FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbProviderGemini" Content="Google Gemini AI (Tự chọn model, có làm mới danh sách)" 
                                     FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" IsChecked="True" 
                                     Margin="0,0,28,0" VerticalAlignment="Center" Checked="RbProvider_Checked"/>
                        <RadioButton x:Name="RbProviderDeepSeek" Content="DeepSeek AI (V3 &amp; R1 Reasoner)" 
                                     FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" 
                                     VerticalAlignment="Center" Checked="RbProvider_Checked"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 1: Google Gemini AI Settings -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSparkles}" Fill="#4F46E5" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="CẤU HÌNH GOOGLE GEMINI API" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Border x:Name="BadgeGeminiActive" Grid.Column="1" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ĐANG HOẠT ĐỘNG" FontSize="10.5" FontWeight="Bold" Foreground="#4F46E5"/>
                        </Border>
                    </Grid>
                    
                    <TextBlock Text="Gemini API Key:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtApiKey" FontSize="14" Padding="10,8" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                        <Button x:Name="BtnTestKey" Grid.Column="1" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Click="BtnTestKey_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoCheckCircle}" Stroke="#4F46E5" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Kiểm tra kết nối" FontWeight="SemiBold" Foreground="#4F46E5"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="Mô hình Gemini (Model - Chọn hoặc tự gõ mã phiên bản):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CboModel" FontSize="13.5" Padding="8,6" IsEditable="True">
                            <ComboBoxItem Content="gemini-2.5-flash" IsSelected="True"/>
                            <ComboBoxItem Content="gemini-2.5-pro"/>
                            <ComboBoxItem Content="gemini-2.5-flash-lite"/>
                            <ComboBoxItem Content="gemini-2.0-flash"/>
                            <ComboBoxItem Content="gemini-2.0-flash-lite"/>
                        </ComboBox>
                        <Button x:Name="BtnRefreshModels" Grid.Column="1" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Click="BtnRefreshModels_Click"
                                ToolTip="Lấy danh sách model Gemini hiện có từ tài khoản của bạn">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Làm mới danh sách" FontWeight="SemiBold" Foreground="#4F46E5"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="Chọn model từ danh sách, hoặc tự gõ mã phiên bản bất kỳ. Bấm 'Làm mới danh sách' để cập nhật các model Google hiện có cho API Key của bạn." 
                               FontSize="12" Foreground="#94A3B8" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Card 2: DeepSeek AI Settings -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSparkles}" Fill="#0284C7" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="CẤU HÌNH DEEPSEEK AI" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Border x:Name="BadgeDeepSeekActive" Grid.Column="1" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="ĐANG HOẠT ĐỘNG" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="DeepSeek API Key:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDeepSeekKey" FontSize="14" Padding="10,8" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                        <Button x:Name="BtnTestDeepSeek" Grid.Column="1" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Click="BtnTestDeepSeek_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoCheckCircle}" Stroke="#0284C7" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Kiểm tra kết nối" FontWeight="SemiBold" Foreground="#0284C7"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="Mô hình DeepSeek (Model):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboDeepSeekModel" FontSize="13.5" Padding="8,6" Margin="0,0,0,8" IsEditable="True">
                        <ComboBoxItem Content="deepseek-chat" IsSelected="True"/>
                        <ComboBoxItem Content="deepseek-reasoner"/>
                    </ComboBox>
                    <TextBlock Text="Gợi ý: 'deepseek-chat' (DeepSeek-V3) sinh câu hỏi và đáp án nhanh chuẩn; 'deepseek-reasoner' (DeepSeek-R1) chuyên sâu giải toán lập luận Mức 3." 
                               FontSize="12" Foreground="#94A3B8" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Card 3: School Profile Settings -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource GeoBook}" Stroke="#0F766E" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="THÔNG TIN TRƯỜNG &amp; NĂM HỌC (XUẤT WORD)" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 1 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tên Cơ quan quản lý (UBND / Phòng GD&amp;ĐT):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtUbnd" FontSize="14" Padding="10,8" BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                        </StackPanel>

                        <!-- Col 2 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tên Trường Tiểu học:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtTruong" FontSize="14" Padding="10,8" BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 1 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Năm học:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNamHoc" FontSize="14" Padding="10,8" BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                        </StackPanel>

                        <!-- Col 2 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Học kỳ:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CboHocKy" FontSize="13.5" Padding="8,6">
                                <ComboBoxItem Content="CUỐI HỌC KỲ II" IsSelected="True"/>
                                <ComboBoxItem Content="GIỮA HỌC KỲ II"/>
                                <ComboBoxItem Content="CUỐI HỌC KỲ I"/>
                                <ComboBoxItem Content="GIỮA HỌC KỲ I"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 4: Export Folder -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource GeoFolder}" Stroke="#0F766E" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="THƯ MỤC XUẤT FILE WORD (.docx)" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>

                    <TextBlock Text="Nơi lưu các tệp đề và ma trận khi xuất ra Word:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtExportFolder" FontSize="14" Padding="10,8" BorderBrush="#CBD5E1" Background="#F8FAFC"
                                 TextChanged="TxtExportFolder_TextChanged"/>
                        <Button x:Name="BtnBrowseExportFolder" Grid.Column="1" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Click="BtnBrowseExportFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoFolder}" Stroke="#475569" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chọn thư mục..." FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnResetExportFolder" Grid.Column="2" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Click="BtnResetExportFolder_Click"
                                ToolTip="Trở về thư mục mặc định trên Desktop">
                            <TextBlock Text="Về mặc định" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="TxtExportFolderHint" FontSize="12" Foreground="#94A3B8" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 5: LaTeX/TikZ Path -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="22" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource GeoSettings}" Stroke="#7C3AED" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ĐƯỜNG DẪN MIKTEX / LATEX PORTABLE (TÙY CHỌN)" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="Thư mục chứa pdflatex.exe (Nếu để trống, phần mềm sẽ dùng theo PATH hệ thống):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtMiktexPath" FontSize="14" Padding="10,8" BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                        <Button x:Name="BtnBrowseMiktex" Grid.Column="1" Style="{StaticResource StitchSecondaryButton}" Margin="10,0,0,0" Click="BtnBrowseMiktex_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoFolder}" Stroke="#475569" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chọn thư mục..." FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 6: Chế độ vẽ hình TikZ -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="22" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource GeoSparkles}" Stroke="#7C3AED" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="CHẾ ĐỘ VẼ HÌNH TIKZ" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkHinhChuan" FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                              Content="Bảo đảm hình chuẩn (ưu tiên bộ dựng hình chuẩn, hạn chế hình AI vẽ sai)"/>
                    <TextBlock Text="Khi bật: mọi hình sẽ được kiểm tra và ưu tiên vẽ lại bằng bộ dựng chuẩn (bám đúng số liệu trong đề). Hình phức tạp vẫn giao cho AI. Tắt để giữ nguyên hành vi cũ."
                               FontSize="12" Foreground="#94A3B8" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                <TextBlock x:Name="TxtStatusMessage" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="SemiBold" Foreground="#16A34A"/>
                <Button x:Name="BtnSave" Style="{StaticResource StitchPrimaryButton}" Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoSave}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Lưu tất cả Cài đặt" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
